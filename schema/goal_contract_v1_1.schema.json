{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jase.local/schemas/goal-contract-v1_1.json",
  "title": "Jase GoalContract v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goals",
    "clarification"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.1"
      ]
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/goal"
      }
    },
    "clarification": {
      "$ref": "#/$defs/clarification"
    }
  },
  "$defs": {
    "scalar": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "null"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "raw"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property",
        "operator",
        "value"
      ],
      "properties": {
        "property": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "enum": [
            "eq",
            "neq",
            "lt",
            "lte",
            "gt",
            "gte",
            "contains",
            "excludes",
            "before",
            "after",
            "near",
            "within",
            "between",
            "in",
            "not_in"
          ]
        },
        "value": {
          "$ref": "#/$defs/scalar"
        },
        "value_to": {
          "$ref": "#/$defs/scalar"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "raw_action",
        "target",
        "attributes",
        "constraints",
        "preferences"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "raw_action": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          }
        },
        "preferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          }
        },
        "gate": {
          "oneOf": [
            {
              "$ref": "#/$defs/gate"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "reason",
        "missing_fields"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "action_name": {
      "type": "string",
      "minLength": 1
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when",
        "then",
        "otherwise"
      ],
      "description": "Condizione valutata sul risultato trovato, con le azioni dei due rami. Esiste perché GoalContract v1 non sapeva rappresentare 'se la trovi sotto i 600 comprala, altrimenti avvisami' e la degradava a richiesta di chiarimento.",
      "properties": {
        "when": {
          "$ref": "#/$defs/predicate"
        },
        "then": {
          "$ref": "#/$defs/action_name"
        },
        "otherwise": {
          "oneOf": [
            {
              "$ref": "#/$defs/action_name"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
