{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jase.local/schema/train_search_result_v1.schema.json",
  "title": "Jase normalized read-only train journey result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["jase_result_ref", "provider_result_ref", "provider", "query_ref", "origin", "destination", "departure_datetime", "arrival_datetime", "duration_minutes", "number_of_changes", "train_segments", "train_categories", "source_metadata"],
  "properties": {
    "jase_result_ref": {"type": "string", "minLength": 1},
    "provider_result_ref": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "query_ref": {"type": "string", "minLength": 1},
    "origin": {"type": "string", "minLength": 1},
    "destination": {"type": "string", "minLength": 1},
    "departure_datetime": {"type": "string", "format": "date-time"},
    "arrival_datetime": {"type": "string", "format": "date-time"},
    "duration_minutes": {"type": "integer", "minimum": 0},
    "number_of_changes": {"type": "integer", "minimum": 0},
    "train_segments": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["trip_id", "route_id", "origin_stop_id", "destination_stop_id"]}},
    "train_categories": {"type": "array", "items": {"type": "string"}},
    "source_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["source_kind", "source_url", "feed_sha256", "coverage", "realtime", "attribution"],
      "properties": {
        "source_kind": {"enum": ["REAL_PROVIDER", "RECORDED_FIXTURE", "SANDBOX_PROVIDER", "MOCK"]},
        "source_url": {"type": "string", "format": "uri"},
        "feed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage": {"type": "string"},
        "realtime": {"type": "boolean"},
        "attribution": {"type": "string"}
      }
    }
  }
}
