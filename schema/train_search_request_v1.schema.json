{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jase.local/schema/train_search_request_v1.schema.json",
  "title": "Jase read-only train search provider request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["origin", "destination", "travel_date", "time_constraints", "direct_only", "train_category", "max_duration_minutes", "limit", "sort", "field_provenance"],
  "properties": {
    "origin": {"type": "string", "minLength": 1},
    "destination": {"type": "string", "minLength": 1},
    "travel_date": {"type": "string", "format": "date"},
    "time_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "operator", "start", "end", "inclusive"],
        "properties": {
          "role": {"enum": ["departure_time", "arrival_time"]},
          "operator": {"enum": ["before", "after", "between", "eq"]},
          "start": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
          "end": {"type": ["string", "null"]},
          "inclusive": {"type": "boolean"}
        }
      }
    },
    "direct_only": {"type": "boolean"},
    "train_category": {"type": ["string", "null"], "enum": ["regional", null]},
    "max_duration_minutes": {"type": ["integer", "null"], "minimum": 0},
    "limit": {"type": "integer", "minimum": 1, "maximum": 100},
    "sort": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "direction"],
      "properties": {
        "field": {"enum": ["departure_time", "arrival_time", "duration"]},
        "direction": {"enum": ["asc", "desc"]}
      }
    },
    "field_provenance": {
      "type": "object", "minProperties": 5,
      "required": ["origin", "destination", "travel_date", "origin_stop_ids", "destination_stop_ids"],
      "additionalProperties": {"type": "object", "required": ["source"]}
    }
  }
}
