{"id": "s01", "text": "Mi trovi un bed and breakfast a Parma entro 75 euro? Se c'è il parcheggio, meglio.", "contract": {"schema_version": "1.2", "kind": "task", "goals": [{"id": "g1", "action": "find", "target": {"name": "bed and breakfast", "type": "accommodation"}, "facts": [{"field": "location", "op": "near", "value": "Parma", "strength": "hard"}, {"field": "price", "op": "lte", "value": 75, "strength": "hard", "currency": "EUR"}, {"field": "amenity", "op": "eq", "value": "parcheggio", "strength": "soft"}]}]}, "tags": ["hard_soft"]}
